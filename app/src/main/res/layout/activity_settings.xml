<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#091D39"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personalise your Smart Pantry Manager experience."
            android:textColor="#555555"
            android:textSize="16sp"
            android:paddingBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preferred Measurement System"
            android:textColor="#091D39"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgUnitPreference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbMetric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Metric (g, kg, ml, litres)" />

            <RadioButton
                android:id="@+id/rbImperial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Imperial (oz, lb, cups, fl oz)" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D5DCE5"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry Reminders"
            android:textColor="#091D39"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable reminders for ingredients approaching their expiry date."
            android:textColor="#555555"
            android:textSize="14sp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp" />

        <Switch
            android:id="@+id/swExpiryReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable expiry reminders"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_marginTop="28dp" />

        <Button
            android:id="@+id/btnSettingsBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Home"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>